# ── Core (required) ────────────────────────────────────────────────────────

# Postgres connection string. The docker-compose.yml default matches its
# own postgres service — change it if you're pointing at a different DB.
DATABASE_URL=postgres://seenpaid:seenpaid@localhost:5432/seenpaid

# Redis for the BullMQ publish queue. Split into host/port instead of a URL
# to match ioredis's connection object (see src/jobs/connection.ts).
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Your single API key — generate one with `openssl rand -hex 32`. Sent as
# `Authorization: Bearer <API_KEY>` (or `X-Api-Key: <API_KEY>`) on every
# request to the REST API and the MCP endpoint. There is no login flow —
# this key IS the account. Treat it like a password. See SELF_HOST.md.
API_KEY=

# 32+ random bytes used to encrypt OAuth tokens at rest (AES-256-GCM).
# Generate with `openssl rand -hex 32`. Losing this key means every
# connected account needs to be reconnected — back it up somewhere safe.
TOKEN_ENCRYPTION_KEY=

# Public URL this instance is reachable at. Used to build OAuth redirect
# URIs and links in failure-alert emails.
APP_URL=http://localhost:3001

PORT=3001
NODE_ENV=development
# LOG_LEVEL=info

# Comma-separated list of origins allowed to call the API from a browser
# (e.g. a self-built dashboard). Not needed if you only call the API
# server-to-server or connect an agent over MCP.
# ALLOWED_ORIGINS=http://localhost:3000

# ── Media storage (S3-compatible object store) ──────────────────────────────
# Any S3-compatible store works. docker-compose.yml ships a MinIO service
# as the zero-config local default — the S3_* vars below match it. To use
# Cloudflare R2 instead, set R2_ACCOUNT_ID/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY/
# R2_BUCKET/R2_PUBLIC_BASE_URL and leave the S3_* vars unset.

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=seenpaid-media
# Public URL media becomes reachable at once uploaded (point this at your
# MinIO/R2 bucket's public endpoint or a CDN in front of it).
S3_PUBLIC_BASE_URL=http://localhost:9000/seenpaid-media

# ── Optional: publish-failure email alerts ──────────────────────────────────
# Both unset = failures are only logged, not emailed. Fully optional.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="seenpaid <you@yourdomain.com>"
# OWNER_EMAIL=you@yourdomain.com

# ── Platform OAuth app credentials ──────────────────────────────────────────
# Only needed for platforms that use OAuth (most of them). Several platforms
# connect with a pasted token/webhook/password instead and need NO app
# credentials at all: Bluesky, Discord, Telegram, Nostr, Dev.to, Hashnode,
# Medium, Slack, WordPress, Ghost, Lemmy, Webhook, Micro.blog, Matrix, X
# (BYOK — bring your own X app keys per-account, not set here).
#
# Register a developer app on each platform you want and fill in its
# client id/secret below. Leave the rest blank — connecting an unconfigured
# platform just fails with a clear error, everything else keeps working.
# See SELF_HOST.md for links to each platform's developer console.

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta (Facebook + Instagram share one app)
META_APP_ID=
META_APP_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

MASTODON_INSTANCE_URL=
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

VK_CLIENT_ID=
VK_CLIENT_SECRET=

# X (bring-your-own-app: X_CLIENT_ID/SECRET are used by the app-owner OAuth
# flow if you build one; the shipped connect flow is per-account BYOK and
# needs no app-level credentials here).
X_CLIENT_ID=
X_CLIENT_SECRET=

# Relay list for Nostr (comma-separated). Sensible public defaults are
# baked in if unset — see src/platforms/nostr.adapter.ts.
# NOSTR_RELAYS=
