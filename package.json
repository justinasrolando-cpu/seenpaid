{
  "name": "seenpaid",
  "version": "0.1.0",
  "description": "Self-hosted, agent-native social posting layer. 25 platform adapters, a BullMQ publish pipeline, and a 3-tool MCP server so an AI agent can post on your behalf.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/entry-points/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/entry-points/api/server.js",
    "worker": "tsx watch src/jobs/worker.ts",
    "worker:prod": "node dist/jobs/worker.js",
    "db:generate": "tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx src/data-access/migrate.ts",
    "db:migrate:prod": "node dist/data-access/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nostr-tools": "^2.23.9",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
